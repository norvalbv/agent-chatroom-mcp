SET total 100
DEF addup n
SET total + total n
RET total
END
PRINT CALL addup 5
PRINT total
DEF bump
GLOBAL total
SET dummy NEXT total
RET total
END
PRINT CALL bump
PRINT total
DEF tick
SET dummy NEXT total
RET total
END
PRINT CALL tick
PRINT total
DEF fact n
IF < n 2
RET 1
END
RET * n CALL fact - n 1
END
PRINT CALL fact 20
PRINT CALL early
DEF early
RET 7
END
PRINT CALL early
DEF shadow
SET total 5
GLOBAL total
PRINT total
SET total 7
RET total
END
PRINT CALL shadow
PRINT total
DEF pair a b
SETS a b b a
RET - a b
END
PRINT CALL pair 3 10
PUSH L 4
PUSH L 8
PUSH L 15
PRINT LEN L
PRINT AT L -1
PRINT AT L 3
PRINT AT L -4
PRINT AT L 0
DEF fill n
REPEAT n
PUSH L * NEXT k NEXT k
END
RET LEN L
END
PRINT CALL fill 3
PRINT AT L 5
PRINT k
SET i 0
SET s 0
WHILE < i 10
SET i + i 1
IF = % i 3 0
CONTINUE
END
IF < 8 i
BREAK
END
SET s + s i
END
PRINT s
PRINT i
SET c 3
SET t 0
REPEAT c
SET c 10
SET t + t 1
IF = t 12
CONTINUE
END
SET t + t 10
END
PRINT t
PRINT AND NEXT q NEXT q
PRINT OR 0 NEXT q
PRINT q
PRINT POW 2 100
PRINT POW 0 0
PRINT POW 5 -1
PRINT MIN ABS -9 NOT 7
PRINT MAX -3 - 0 3
DEF outer a
DEF inner b
RET + a b
END
RET CALL inner 100
END
PRINT CALL outer 1
PRINT CALL inner 5
