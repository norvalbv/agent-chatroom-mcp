diff --git a/scripts/room-directory-regression.ts b/scripts/room-directory-regression.ts
new file mode 100644
index 00000000..0003db83
--- /dev/null
+++ b/scripts/room-directory-regression.ts
@@ -0,0 +1,84 @@
+/** MCP room discovery: a directory first, full room detail on demand. */
+import assert from "node:assert/strict";
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { InMemoryTransport } from "@modelcontextprotocol/sdk/inMemory.js";
+import { Hub } from "../src/hub.js";
+import { createSessionServer } from "../src/server.js";
+
+Hub.DEFAULT_NUDGE_MS = 0;
+const hub = new Hub();
+const session = createSessionServer(hub);
+const client = new Client({ name: "directory-check", version: "1" });
+const [ct, st] = InMemoryTransport.createLinkedPair();
+await session.server.connect(st);
+await client.connect(ct);
+const call = async (name: string, args: Record<string, unknown> = {}) => {
+  const out = await client.callTool({ name, arguments: args });
+  assert.ok(!out.isError, JSON.stringify(out));
+  return JSON.parse((out.content as { text: string }[])[0].text);
+};
+try {
+  const topic = "Compiler team: " + "implementation context ".repeat(200) + "TAIL-TOPIC";
+  const a = hub.join("run-a-build", "Alice", "codex", { topic }, undefined, "alice").participant;
+  hub.join("run-a-build", "Bob", "claude", {}, undefined, "bob");
+  hub.setBoard("run-a-build", a.id, "evidence/long", "evidence ".repeat(700));
+  hub.propose("run-a-build", a.id, "Adopt the implementation. " + "reason ".repeat(200));
+  hub.createRoom("run-a-closed", { topic: "Completed compiler team" });
+  hub.closeRoom("run-a-closed", "test", "done");
+  hub.createRoom("run-b-other", { topic: "Other unrelated task" });
+  hub.createRoom("run-a-archived", { topic: "Archived task" });
+  hub.archiveRoom("run-a-archived", "test");
+  const secret = hub.join("anonymous", "PrivateName", "codex", { anonymous: true }, undefined, "private-session").participant;
+  hub.setBoard("anonymous", secret.id, "draft/secret", "PRIVATE-DRAFT-TEXT");
+
+  const rows = await call("list_rooms", { prefix: "run-a-", state: "open" });
+  assert.deepEqual(rows.map((r: { name: string }) => r.name), ["run-a-build"], "filters reach the MCP dispatch");
+  assert.equal(rows[0].topic_chars, topic.length);
+  assert.ok(rows[0].topic.length <= 241);
+  assert.equal(rows[0].active_count, 2);
+  assert.deepEqual(rows[0].participants.map((p: { name: string }) => p.name), ["Alice", "Bob"]);
+  assert.equal(rows[0].board, undefined, "directory omits board contents and manifests");
+  assert.equal(rows[0].proposals, undefined, "directory omits proposal bodies");
+  const full = await call("list_rooms", { prefix: "run-a-", state: "open", full: true });
+  assert.equal(full[0].topic, topic, "full=true recovers the prior full summary");
+  assert.ok(full[0].board["evidence/long"]);
+  assert.ok(full[0].proposals[0].text.includes("reason"));
+  const status = await call("room_status", { room: "run-a-build", full_topic: true });
+  assert.equal(status.topic, topic, "one-room drilldown needs no membership");
+  assert.deepEqual(await call("list_rooms", { prefix: "missing-" }), []);
+  const all = await call("list_rooms");
+  assert.equal(all.length, 4, "default covers all nonarchived rooms");
+  assert.deepEqual((await call("list_rooms", { state: "closed" })).map((r: { name: string }) => r.name), ["run-a-closed"]);
+  const anon = all.find((r: { name: string }) => r.name === "anonymous");
+  assert.equal(anon.participants[0].name, "Participant A");
+  assert.equal(anon.participants[0].agent, "hidden");
+  assert.ok(!JSON.stringify(all).includes("PrivateName"));
+  assert.ok(!JSON.stringify(all).includes(secret.id));
+  assert.ok(!JSON.stringify(all).includes("private-session"));
+  assert.ok(!JSON.stringify(await call("list_rooms", { full: true })).includes("PRIVATE-DRAFT-TEXT"));
+  const before = Buffer.byteLength(JSON.stringify(hub.listRooms()));
+  const after = Buffer.byteLength(JSON.stringify(all));
+  assert.ok(after < before / 3, `${before} -> ${after} bytes`);
+  const completed = hub.join("done", "DoneA", "test", { requireChallenge: false }, undefined, "done-a").participant;
+  const reviewer = hub.join("done", "DoneB", "test", {}, undefined, "done-b").participant;
+  const text = "Accepted result. " + "verified details ".repeat(50);
+  const proposal = hub.propose("done", completed.id, text);
+  hub.vote("done", reviewer.id, proposal.id, "agree", undefined, undefined, "Accepted result.");
+  const concluded = await call("list_rooms", { state: "concluded" });
+  assert.equal(concluded.length, 1);
+  assert.equal(concluded[0].name, "done");
+  assert.equal(concluded[0].conclusion.chars, text.length);
+  assert.ok(concluded[0].conclusion.text.length <= 241);
+  assert.equal((await call("list_rooms", { prefix: "done", full: true }))[0].conclusion.text, text);
+  hub.archiveRoom("done", "test");
+  assert.deepEqual(await call("list_rooms", { state: "concluded" }), [], "fresh listing reflects archival");
+  console.log(`ROOM DIRECTORY OK; same fixture ${before} -> ${after} bytes`);
+} finally {
+  await client.close();
+  await session.server.close();
+  for (const room of hub.rooms.values()) {
+    clearTimeout(room.nudgeTimer);
+    clearTimeout(room.openingsTimer);
+    clearTimeout(room.draftsTimer);
+  }
+}
