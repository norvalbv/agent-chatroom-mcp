{
  "name": "agent-chatroom-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives AI agents (Claude Code, Codex, OpenRouter models, ...) a shared chatroom with consensus primitives",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/offline-runner.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:openrouter": "tsx scripts/openrouter-smoke.ts",
    "seat:trial": "tsx scripts/seat-trial.ts",
    "debate": "bash scripts/debate.sh",
    "swarm": "node dist/swarm.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "husky && (command -v devkit >/dev/null 2>&1 && devkit sync-hook-runner || true)",
    "guard:freeze": "guard-fanout freeze && guard-size freeze"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "@norvalbv/devkit": "git+https://github.com/norvalbv/devkit.git#v0.62.0",
    "@biomejs/biome": "^2.5.0",
    "husky": "^9.1.7"
  },
  "bin": {
    "agent-chatroom-mcp": "dist/index.js",
    "agent-swarm": "dist/swarm.js",
    "agent-openrouter": "dist/openrouter.js"
  }
}
