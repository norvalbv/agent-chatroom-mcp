# ---- part 1: plain forms
LET g = 10
SHOW (if 1 (out 5) (out 6))
SHOW (if 0 (out 7) (out 8))
SHOW (and 0 (out 9))
SHOW (or 1 (out 4))
SHOW (and (out 1) (out 0))
SHOW (seq (out 2) (out 3))
SHOW (if (out 0) 11 12)
SHOW (peek 0)

# ---- part 2: functions with effects
DEF loud x = (out x)
DEF note k = (bump k)
DEF both a b = (seq a b)
DEF pick c a b = (if c a b)
DEF guard x = (if (< x 3) (note 1) (note 2))
SHOW (both (loud 1) (loud 2))
SHOW (pick 1 (loud 20) (loud 30))
SHOW (pick 0 (loud 40) (loud 50))
SHOW (guard 1)
SHOW (guard 5)
SHOW (peek 1)
SHOW (peek 2)
SHOW (or (note 3) (note 3))
SHOW (and (note 4) (note 5))
SHOW (peek 3)

# ---- part 3: recursion under the depth limit
DEF f n = (if (< n 1) (bump 6) (+ (f (- n 1)) (f (- n 2))))
SHOW (f 2)
SHOW (peek 6)
DEF g2 n = (if (< n 1) 0 (+ (bump 7) (g2 (- n 1))))
SHOW (g2 3)
SHOW (peek 7)
DEF h n = (if (= n 0) (out 100) (seq (out n) (h (- n 1))))
SHOW (h 2)

# ---- part 4: parameters shadow globals
DEF shade g = (if g (+ g 1) (* g g))
SHOW (shade 3)
SHOW (shade 0)
SHOW g
DEF lazyish n = (if n (out (* n 10)) (out (- 0 n)))
SHOW (lazyish 4)
SHOW (lazyish 0)
DEF chain x = (and (out x) (and (out (+ x 1)) (out (+ x 2))))
SHOW (chain 1)
SHOW (chain 0)
SHOW (peek 6)
