SET kal % + $kak $kab 7
SET kam + * IF < $kai 34 $kae 0 3 * IF < $kah $kak $kag 22 3
SET kan MAX MAX 21 5 - $kah $kaj
SET kan MAX $kad $kab
SET kao - + 35 14 - $kai $kag
SET kap MAX 38 12
LAYER team 30
SET kab - + IF < $kaa $kaa $kaa -4 MIN 32 39 / * 18 4 5 WHEN = % $kaa 3 0
SET kai - / $kab 2 % 31 10 WHEN = % $kag 3 1
SET kaj - + + $kaf $kai MIN $kaf $kag + * 9 3 / $kah 2 WHEN = % $kag 3 0
