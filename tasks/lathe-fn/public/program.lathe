SET n 1000
SET f 7
SET g 3
SET acc 50
SET k 2
SET s 100
FN sq x
  RET * x x
END
FN dbl x
  RET * 2 x
END
FN fact x
  IF < x 2
    RET 1
  END
  RET * x CALL fact - x 1
END
FN digsum x
  SET t 0
  WHILE < 0 x
    SET t + t % x 10
    SET x / x 10
  END
  RET t
END
FN collatz x
  SET steps 0
  WHILE < 1 x
    IF % x 2
      SET x + * 3 x 1
    ELSE
      SET x / x 2
    END
    SET steps + steps 1
  END
  RET steps
END
FN make_adder n
  FN add y
    RET + y n
  END
  RET add
END
FN bump d
  GLOBAL acc
  SET acc + acc d
  RET acc
END
FN sumsq m
  SET total 0
  FN addto q
    SET total + total * q q
  END
  SET i 1
  WHILE < i + m 1
    DO CALL addto i
    SET i + i 1
  END
  RET total
END
FN twice h
  FN both x
    RET CALL h CALL h x
  END
  RET both
END
FN make_counter s
  FN next d
    SET s + s d
    RET s
  END
  RET next
END
FN reader x
  RET + x zz
END
FN viacaller zz
  RET CALL reader 1
END
FN pick which
  IF = which 1
    RET sq
  END
  IF = which 2
    RET dbl
  END
  RET fact
END
FN apply2 sel
  FN inner v
    RET CALL CALL pick sel v
  END
  RET inner
END
PRINT CALL sq 12
PRINT CALL fact 15
PRINT CALL digsum 987654321
PRINT CALL digsum CALL fact 20
PRINT CALL collatz 27
PRINT CALL collatz 97
SET add5 CALL make_adder 5
PRINT CALL add5 10
SET add7 CALL make_adder 7
PRINT CALL add7 CALL add5 1
PRINT CALL bump 5
PRINT CALL bump 10
PRINT acc
PRINT CALL sumsq 4
PRINT CALL sumsq 10
SET h dbl
SET quad CALL twice sq
PRINT CALL quad 3
SET c1 CALL make_counter 5
PRINT CALL c1 1
PRINT CALL c1 1
PRINT CALL c1 10
PRINT s
SET q 0
SET i 1
WHILE < i 30
  IF = CALL digsum i 7
    SET q + q i
  END
  SET i + i 1
END
PRINT q
SET w 2
SET sel 1
SET runner CALL apply2 3
PRINT CALL runner 5
SET sel 2
PRINT CALL runner 5
SET sel 1
SET runner2 CALL apply2 2
PRINT CALL runner2 9
PRINT CALL CALL twice dbl 5
SET zz 90
PRINT CALL viacaller 5
SET j 0
SET x 0
WHILE < j 12
  SET x + x CALL add5 j
  SET j + j 1
END
PRINT x
PRINT k
PRINT f
PRINT g
