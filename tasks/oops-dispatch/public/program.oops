CLASS A
DEF m = "a"
DEF who = HERE + "/" + OBJ
DEF chain = "A" + SELF m
CLASS B : A
DEF m = "b:" + SUPER
CLASS C : A
DEF m = "c:" + SUPER
DEF who = "C!" + SUPER
CLASS D : B C
CLASS E : C B
DEF chain = "E" + SUPER
CLASS F
DEF m = "f"
DEF n = "n" + SELF m
CLASS G : D F
DEF m = "g:" + SUPER
CLASS H : F D
CLASS I : H
DEF n = "i" + SUPER
DEF m = SUPER + ":i"
PRINT A m
PRINT B m
PRINT C m
PRINT D m
PRINT E m
PRINT D who
PRINT E who
PRINT D chain
PRINT E chain
PRINT G m
PRINT H m
PRINT H n
PRINT I m
PRINT I n
PRINT I who
PRINT F who
PRINT G n
PRINT G who
PRINT G chain
